// Тема «Modern»: почти прозрачное меню с размытием — исходная тема автора пресета
$preset_theme = 'modern'

theme
{
    name = "modern"
    dark = auto

    background
    {
        color = #252525
        opacity = 5
        effect = 2 // 0 = выкл, 1 = прозрачный, 2 = размытие, 3 = акрил
    }

    border
    {
        enabled = true
        size = 1
        color = #3A3B3C
        opacity = 100
        radius = 2
    }

    image.align = 2

    layout
    {
        popup = 0
    }
}
