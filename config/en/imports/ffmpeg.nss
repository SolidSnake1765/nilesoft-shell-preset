// FFmpeg — convert video, audio and images from the context menu.
// The menu only calls imports/ffmpeg-run.ps1 with an operation name; all ffmpeg commands
// and the mode logic live in that script.
// The mode (first menu item) and the settings (“Settings” submenu) are stored in the registry:
//   copy    - the result is saved next to the source under a new name, the source stays untouched;
//   replace - the result takes the source name, the source goes to the Recycle Bin.
// This file is generated by dev/build_ffmpeg_nss.py - better edit that script.

// Where ffmpeg is is set in imports/paths.nss ($ff_bin). The script gets the path from here.
$ff_exe  = ff_bin + '\ffmpeg.exe'
$ff_probe = ff_bin + '\ffprobe.exe'
$ff_play  = ff_bin + '\ffplay.exe'
$ff_run   = '-NoProfile -ExecutionPolicy Bypass -File "' + path.combine(app.dir, 'imports', 'ffmpeg-run.ps1') + '" -FFmpeg "' + ff_exe + '"'
$ff_key   = 'HKCU\Software\Nilesoft-FFmpeg-menu'

// Which files count as video, audio and images
$ff_video = '.mp4|.mkv|.mov|.avi|.webm|.m4v|.ts|.mts|.m2ts|.flv|.wmv|.mpg|.mpeg|.3gp|.vob|.ogv'
$ff_audio = '.mp3|.m4a|.aac|.flac|.wav|.ogg|.opus|.wma|.ac3|.dts|.aiff|.ape|.wv|.mka'
$ff_image = '.jpg|.jpeg|.png|.webp|.avif|.bmp|.tif|.tiff|.gif'

$svg_ffmpeg = '<svg width="100" height="100" viewBox="0 0 48 48"><path fill="#388e3c" d="M39.5 42h-9c-1 0-1.9-.6-2.3-1.5s-.2-2 .5-2.7l8.3-8.3v-3.9L21.3 41.3c-.5.5-1.1.7-1.8.7h-11c-1 0-1.9-.6-2.3-1.5s-.2-2 .5-2.7L33.5 11h-3.9L10.3 30.3c-.7.7-1.8.9-2.7.5-1-.4-1.6-1.3-1.6-2.3v-11c0-.7.3-1.3.7-1.8l4.7-4.7h-3C7.1 11 6 9.9 6 8.5S7.1 6 8.5 6h9c1 0 1.9.6 2.3 1.5s.2 2-.5 2.7L11 18.5v3.9L26.7 6.7c.5-.4 1.1-.7 1.8-.7h11c1 0 1.9.6 2.3 1.5s.2 2-.5 2.7L14.5 37h3.9l19.3-19.3c.7-.7 1.8-.9 2.7-.5s1.5 1.3 1.5 2.3v11c0 .7-.3 1.3-.7 1.8L36.5 37h3c1.4 0 2.5 1.1 2.5 2.5S40.9 42 39.5 42"/></svg>'

menu(title='FFmpeg' mode='multiple' type='file' find=ff_video+'|'+ff_audio+'|'+ff_image image=image.svg(svg_ffmpeg)
	where=path.exists(ff_exe))
{
	// Mode switch: copy / replace
	item(mode='multiple' title=if(reg.get(ff_key, 'Mode') == 'replace', 'Mode: replace', 'Mode: copy')
		tip=if(reg.get(ff_key, 'Mode') == 'replace', 'After processing the source goes to the Recycle Bin and the result takes its name. Click to switch to copy', 'The result is saved next to the source, the source stays untouched. Click to switch to replace')
		cmd=reg.set(ff_key, 'Mode', if(reg.get(ff_key, 'Mode') == 'replace', 'copy', 'replace'), reg.sz))
	menu(mode='multiple' title='Settings')
	{
		item(mode='multiple' title='Save copies to the “FFmpeg” subfolder' checked=if(reg.get(ff_key, 'OutDir') == 'sub', true, false)
			tip='Off - results are saved next to the source'
			cmd=reg.set(ff_key, 'OutDir', if(reg.get(ff_key, 'OutDir') == 'sub', 'here', 'sub'), reg.sz))
		item(mode='multiple' where=if(reg.get(ff_key, 'GpuEnc') == 'nvenc' or reg.get(ff_key, 'GpuEnc') == 'amf' or reg.get(ff_key, 'GpuEnc') == 'qsv', true, if(reg.get(ff_key, 'GpuEnc') == 'none', false, has_gpu_hint)) title='Encode video on the graphics card' checked=if(reg.get(ff_key, 'Encoder') == 'gpu', true, false)
			tip='NVIDIA, AMD or Intel: many times faster, slightly bigger file. Off - the CPU (x264), better quality per megabyte'
			cmd=reg.set(ff_key, 'Encoder', if(reg.get(ff_key, 'Encoder') == 'gpu', 'cpu', 'gpu'), reg.sz))
		item(mode='multiple' title='Always wait for Enter at the end' checked=if(reg.get(ff_key, 'Window') == 'wait', true, false)
			tip='Off - after a successful run the window closes itself in 3 seconds'
			cmd=reg.set(ff_key, 'Window', if(reg.get(ff_key, 'Window') == 'wait', 'auto', 'wait'), reg.sz))
		item(mode='multiple' title='Beep when done' checked=if(reg.get(ff_key, 'Beep') == 'on', true, false)
			tip='Handy for long jobs: you can do something else meanwhile'
			cmd=reg.set(ff_key, 'Beep', if(reg.get(ff_key, 'Beep') == 'on', 'off', 'on'), reg.sz))
		item(mode='multiple' title='Show the result in Explorer' checked=if(reg.get(ff_key, 'Reveal') == 'on', true, false)
			tip='After processing the folder opens with the result selected'
			cmd=reg.set(ff_key, 'Reveal', if(reg.get(ff_key, 'Reveal') == 'on', 'off', 'on'), reg.sz))
		item(mode='multiple' title='Check graphics card'
			tip='Whether the graphics card can encode video (NVIDIA, AMD, Intel). Run it after changing the card or the driver'
			cmd='powershell.exe' args='@ff_run -Preset gpu-detect')
	}
	separator()
	menu(mode='multiple' expanded=1 find=ff_video)
	{
		menu(mode='multiple' title='To MP4 without quality loss' tip='For files that Telegram and phones do not accept as video')
		{
			item(mode='multiple' title='Automatic (for Telegram)'
				tip='H.264 video is copied as is, lossless and instant. Only what does not fit MP4 is re-encoded'
				cmd='powershell.exe' args='@ff_run -Preset hq -Value auto @sel(true," ")')
			separator()
			item(mode='multiple' title='H.264 on the CPU'
				tip='Visually lossless (CRF 17). Plays everywhere'
				cmd='powershell.exe' args='@ff_run -Preset hq -Value h264 @sel(true," ")')
			item(mode='multiple' where=if(reg.get(ff_key, 'GpuEnc') == 'nvenc' or reg.get(ff_key, 'GpuEnc') == 'amf' or reg.get(ff_key, 'GpuEnc') == 'qsv', true, if(reg.get(ff_key, 'GpuEnc') == 'none', false, has_gpu_hint)) title='H.264 on the graphics card'
				tip='Visually lossless, many times faster. Bigger file than on the CPU'
				cmd='powershell.exe' args='@ff_run -Preset hq -Value h264gpu @sel(true," ")')
			item(mode='multiple' title='H.265 on the CPU'
				tip='Visually lossless, smaller file. Not every Telegram client plays it'
				cmd='powershell.exe' args='@ff_run -Preset hq -Value h265 @sel(true," ")')
			item(mode='multiple' where=if(reg.get(ff_key, 'GpuEnc') == 'nvenc' or reg.get(ff_key, 'GpuEnc') == 'amf' or reg.get(ff_key, 'GpuEnc') == 'qsv', true, if(reg.get(ff_key, 'GpuEnc') == 'none', false, has_gpu_hint)) title='H.265 on the graphics card'
				tip='Visually lossless, fast. Not every Telegram client plays it'
				cmd='powershell.exe' args='@ff_run -Preset hq -Value h265gpu @sel(true," ")')
		}
		menu(mode='multiple' title='Compress')
		{
			item(mode='multiple' title='H.264 (plays everywhere)'
				tip='Much smaller size with good quality'
				cmd='powershell.exe' args='@ff_run -Preset compress @sel(true," ")')
			item(mode='multiple' title='H.265 (even smaller, slower)'
				tip='Smaller size at the same quality, but slower to encode'
				cmd='powershell.exe' args='@ff_run -Preset h265 @sel(true," ")')
			item(mode='multiple' where=if(reg.get(ff_key, 'GpuEnc') == 'nvenc' or reg.get(ff_key, 'GpuEnc') == 'amf' or reg.get(ff_key, 'GpuEnc') == 'qsv', true, if(reg.get(ff_key, 'GpuEnc') == 'none', false, has_gpu_hint)) title='On the graphics card (H.265, fast)'
				tip='Many times faster, slightly bigger file'
				cmd='powershell.exe' args='@ff_run -Preset gpu265 @sel(true," ")')
		}
		menu(mode='multiple' title='Fit into a size limit' tip='Any video is guaranteed to fit: resolution and frame rate are picked for its length')
		{
			menu(mode='multiple' title='Discord — 20 MB')
			{
				item(mode='multiple' title='Auto - balanced'
					tip='Picks the resolution and frame rate for the video length'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord20:auto:h264 @sel(true," ")')
				item(mode='multiple' title='Smooth - 60 fps'
					tip='For games: keeps 60 fps at the cost of resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord20:smooth:h264 @sel(true," ")')
				item(mode='multiple' title='Sharp - 30 fps'
					tip='For talking heads and screen recordings: 30 fps, but higher resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord20:sharp:h264 @sel(true," ")')
				separator()
				item(mode='multiple' title='Auto, H.265 - better quality'
					tip='Sharper at the same size. Discord supports it, but its built-in player may not show it on old computers'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord20:auto:h265 @sel(true," ")')
			}
			menu(mode='multiple' title='Discord — 10 MB (old limit)')
			{
				item(mode='multiple' title='Auto - balanced'
					tip='Picks the resolution and frame rate for the video length'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord10:auto:h264 @sel(true," ")')
				item(mode='multiple' title='Smooth - 60 fps'
					tip='For games: keeps 60 fps at the cost of resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord10:smooth:h264 @sel(true," ")')
				item(mode='multiple' title='Sharp - 30 fps'
					tip='For talking heads and screen recordings: 30 fps, but higher resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord10:sharp:h264 @sel(true," ")')
				separator()
				item(mode='multiple' title='Auto, H.265 - better quality'
					tip='Sharper at the same size. Discord supports it, but its built-in player may not show it on old computers'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value discord10:auto:h265 @sel(true," ")')
			}
			menu(mode='multiple' title='Catbox — 200 MB')
			{
				item(mode='multiple' title='Auto - balanced'
					tip='Picks the resolution and frame rate for the video length'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value catbox:auto:h264 @sel(true," ")')
				item(mode='multiple' title='Smooth - 60 fps'
					tip='For games: keeps 60 fps at the cost of resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value catbox:smooth:h264 @sel(true," ")')
				item(mode='multiple' title='Sharp - 30 fps'
					tip='For talking heads and screen recordings: 30 fps, but higher resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value catbox:sharp:h264 @sel(true," ")')
				separator()
				item(mode='multiple' title='Auto, H.265 - better quality'
					tip='Sharper at the same size, but not every browser (Firefox, for example) plays H.265'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value catbox:auto:h265 @sel(true," ")')
			}
			separator()
			menu(mode='multiple' title='Custom size…' tip='Asks how many megabytes the result should be')
			{
				item(mode='multiple' title='Auto - balanced'
					tip='Picks the resolution and frame rate for the video length'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value custom:auto:h264 @sel(true," ")')
				item(mode='multiple' title='Smooth - 60 fps'
					tip='For games: keeps 60 fps at the cost of resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value custom:smooth:h264 @sel(true," ")')
				item(mode='multiple' title='Sharp - 30 fps'
					tip='For talking heads and screen recordings: 30 fps, but higher resolution'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value custom:sharp:h264 @sel(true," ")')
				separator()
				item(mode='multiple' title='Auto, H.265 - better quality'
					tip='Sharper at the same size, but not every browser (Firefox, for example) plays H.265'
					cmd='powershell.exe' args='@ff_run -Preset fit -Value custom:auto:h265 @sel(true," ")')
			}
		}
		menu(mode='multiple' title='Downscale')
		{
			item(mode='multiple' title='To 1080p'
				tip='Keeps the aspect ratio, smaller videos are not enlarged'
				cmd='powershell.exe' args='@ff_run -Preset height -Value 1080 @sel(true," ")')
			item(mode='multiple' title='To 720p'
				tip='Keeps the aspect ratio, smaller videos are not enlarged'
				cmd='powershell.exe' args='@ff_run -Preset height -Value 720 @sel(true," ")')
			item(mode='multiple' title='To 480p'
				tip='Keeps the aspect ratio, smaller videos are not enlarged'
				cmd='powershell.exe' args='@ff_run -Preset height -Value 480 @sel(true," ")')
		}
		menu(mode='multiple' title='Trim')
		{
			item(mode='multiple' title='Fast, without re-encoding…'
				tip='Asks for start and end. Instant, but cuts at the nearest keyframes'
				cmd='powershell.exe' args='@ff_run -Preset trim @sel(true," ")')
			item(mode='multiple' title='Exact, with re-encoding…'
				tip='Asks for start and end. Cuts exactly at the given time'
				cmd='powershell.exe' args='@ff_run -Preset trim-exact @sel(true," ")')
		}
		menu(mode='multiple' title='Speed' tip='Audio is sped up together with the video, the pitch stays the same')
		{
			item(mode='multiple' title='0.5×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 0.5 @sel(true," ")')
			item(mode='multiple' title='0.75×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 0.75 @sel(true," ")')
			item(mode='multiple' title='1.25×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 1.25 @sel(true," ")')
			item(mode='multiple' title='1.5×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 1.5 @sel(true," ")')
			item(mode='multiple' title='2×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 2 @sel(true," ")')
		}
		menu(mode='multiple' title='Frame rate' tip='60 from 30 does not make motion smoother - frames are just repeated')
		{
			item(mode='multiple' title='30 fps'
				cmd='powershell.exe' args='@ff_run -Preset fps -Value 30 @sel(true," ")')
			item(mode='multiple' title='60 fps'
				cmd='powershell.exe' args='@ff_run -Preset fps -Value 60 @sel(true," ")')
		}
		menu(mode='multiple' title='Rotate' tip='Regular items re-encode the video to MP4 (high quality H.264)')
		{
			menu(mode='multiple' find='.mp4|.mov|.m4v' title='Instantly, without re-encoding' tip='Only the rotation flag changes - lossless. For phone videos that play sideways')
			{
				item(mode='multiple' title='90° clockwise'
					cmd='powershell.exe' args='@ff_run -Preset lrotate -Value right @sel(true," ")')
				item(mode='multiple' title='90° counterclockwise'
					cmd='powershell.exe' args='@ff_run -Preset lrotate -Value left @sel(true," ")')
				item(mode='multiple' title='180°'
					cmd='powershell.exe' args='@ff_run -Preset lrotate -Value 180 @sel(true," ")')
			}
			separator()
			item(mode='multiple' title='90° clockwise'
				cmd='powershell.exe' args='@ff_run -Preset vrotate -Value right @sel(true," ")')
			item(mode='multiple' title='90° counterclockwise'
				cmd='powershell.exe' args='@ff_run -Preset vrotate -Value left @sel(true," ")')
			item(mode='multiple' title='180°'
				cmd='powershell.exe' args='@ff_run -Preset vrotate -Value 180 @sel(true," ")')
			separator()
			item(mode='multiple' title='Flip horizontally'
				cmd='powershell.exe' args='@ff_run -Preset vrotate -Value hflip @sel(true," ")')
			item(mode='multiple' title='Flip vertically'
				cmd='powershell.exe' args='@ff_run -Preset vrotate -Value vflip @sel(true," ")')
		}
		menu(mode='multiple' title='Enhance' tip='All items re-encode the video to MP4')
		{
			item(mode='multiple' title='Stabilize (remove shake)'
				tip='Two passes: motion analysis and smoothing. Edges get cropped slightly'
				cmd='powershell.exe' args='@ff_run -Preset stab @sel(true," ")')
			item(mode='multiple' title='Denoise'
				tip='For dark and grainy phone videos'
				cmd='powershell.exe' args='@ff_run -Preset denoise @sel(true," ")')
			item(mode='multiple' title='Sharpen'
				tip='Brings out details if the video looks soft'
				cmd='powershell.exe' args='@ff_run -Preset sharpen @sel(true," ")')
			item(mode='multiple' title='Remove black bars'
				tip='Finds bars on the top/bottom/sides and crops them'
				cmd='powershell.exe' args='@ff_run -Preset crop @sel(true," ")')
			item(mode='multiple' title='Deinterlace (remove combing)'
				tip='For old camcorder and TV recordings'
				cmd='powershell.exe' args='@ff_run -Preset deint @sel(true," ")')
			item(mode='multiple' title='Smooth 60 fps (frame interpolation)'
				tip='Generates in-between frames. Very slow - for short clips'
				cmd='powershell.exe' args='@ff_run -Preset interp @sel(true," ")')
		}
		menu(mode='multiple' title='Remux without re-encoding')
		{
			item(mode='multiple' title='To MP4'
				tip='Instant and lossless. Fails if the codecs do not fit MP4'
				cmd='powershell.exe' args='@ff_run -Preset remux-mp4 @sel(true," ")')
			item(mode='multiple' title='To MKV'
				tip='Instant and lossless, all tracks and subtitles are kept'
				cmd='powershell.exe' args='@ff_run -Preset remux-mkv @sel(true," ")')
		}
		item(mode='multiple' where=sel.count>1 title='Join the selected into one file'
			tip='In alphabetical order, without re-encoding. The files must have the same parameters (for example, parts of one recording)'
			cmd='powershell.exe' args='@ff_run -Preset concat @sel(true," ")')
		item(mode='multiple' title='Split into parts…'
			tip='Asks how many minutes per part. Without re-encoding'
			cmd='powershell.exe' args='@ff_run -Preset split @sel(true," ")')
		item(mode='multiple' title='Strip metadata (GPS, camera, dates)'
			tip='Before posting a phone video. Without re-encoding'
			cmd='powershell.exe' args='@ff_run -Preset stripmeta @sel(true," ")')
		menu(mode='multiple' title='Subtitles')
		{
			item(mode='multiple' title='Extract all to separate files'
				tip='SRT, ASS, VTT, SUP — next to the video'
				cmd='powershell.exe' args='@ff_run -Preset subs-extract @sel(true," ")')
			item(mode='multiple' title='Add the file next to the video'
				tip='Takes “name.srt” or “name.en.srt” (.ass, .vtt) and adds it to an MKV as a track you can turn on in the player'
				cmd='powershell.exe' args='@ff_run -Preset subs-add @sel(true," ")')
			item(mode='multiple' title='Burn into the picture'
				tip='Subtitles become part of the picture - visible everywhere. Uses the file next to the video or embedded subtitles'
				cmd='powershell.exe' args='@ff_run -Preset subs-burn @sel(true," ")')
		}
		separator()
		menu(mode='multiple' title='Audio')
		{
			menu(mode='multiple' title='Extract' tip='Always creates a new file, the video stays untouched')
			{
				item(mode='multiple' title='MP3 (320 kbps)'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value mp3 @sel(true," ")')
				item(mode='multiple' title='M4A (AAC 256 kbps)'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value m4a @sel(true," ")')
				item(mode='multiple' title='AAC (256 kbps)'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value aac @sel(true," ")')
				item(mode='multiple' title='OPUS (160 kbps)'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value opus @sel(true," ")')
				item(mode='multiple' title='OGG (Vorbis)'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value ogg @sel(true," ")')
				item(mode='multiple' title='FLAC (lossless)'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value flac @sel(true," ")')
				item(mode='multiple' title='WAV'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value wav @sel(true," ")')
				item(mode='multiple' title='AIFF'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value aiff @sel(true," ")')
				separator()
				item(mode='multiple' title='As is, without re-encoding (MKA)'
					tip='The track unchanged. MKA plays in AIMP, VLC and MPC-HC'
					cmd='powershell.exe' args='@ff_run -Preset extract -Value mka @sel(true," ")')
			}
			item(mode='multiple' title='Remove audio'
				tip='A copy of the video without the audio track, without re-encoding'
				cmd='powershell.exe' args='@ff_run -Preset mute @sel(true," ")')
			item(mode='multiple' title='Pick an audio track…'
				tip='Lists the tracks with their languages and keeps one. Without re-encoding'
				cmd='powershell.exe' args='@ff_run -Preset pickaudio @sel(true," ")')
			item(mode='multiple' title='Clean up voice noise'
				tip='Noise reduction and hum cut. The video is not re-encoded'
				cmd='powershell.exe' args='@ff_run -Preset voice @sel(true," ")')
			separator()
			menu(mode='multiple' title='Louder' tip='+6 dB - about twice the amplitude')
			{
				item(mode='multiple' title='+3 dB'
					cmd='powershell.exe' args='@ff_run -Preset louder -Value 3 @sel(true," ")')
				item(mode='multiple' title='+6 dB'
					cmd='powershell.exe' args='@ff_run -Preset louder -Value 6 @sel(true," ")')
				item(mode='multiple' title='+10 dB'
					cmd='powershell.exe' args='@ff_run -Preset louder -Value 10 @sel(true," ")')
			}
			menu(mode='multiple' title='Quieter')
			{
				item(mode='multiple' title='-3 dB'
					cmd='powershell.exe' args='@ff_run -Preset quieter -Value 3 @sel(true," ")')
				item(mode='multiple' title='-6 dB'
					cmd='powershell.exe' args='@ff_run -Preset quieter -Value 6 @sel(true," ")')
				item(mode='multiple' title='-10 dB'
					cmd='powershell.exe' args='@ff_run -Preset quieter -Value 10 @sel(true," ")')
			}
			item(mode='multiple' title='Normalize loudness'
				tip='Bring to standard loudness (EBU R128, -16 LUFS)'
				cmd='powershell.exe' args='@ff_run -Preset normalize @sel(true," ")')
		}
		menu(mode='multiple' title='Make from video' tip='Always creates a new file, the video stays untouched')
		{
			menu(mode='multiple' title='GIF')
			{
				item(mode='multiple' title='Small (320 px, 10 fps, 64 colors)'
					tip='The lightest file - for messengers'
					cmd='powershell.exe' args='@ff_run -Preset gif -Value 1 @sel(true," ")')
				item(mode='multiple' title='Medium (400 px, 12 fps)'
					tip='Balance of size and quality'
					cmd='powershell.exe' args='@ff_run -Preset gif -Value 2 @sel(true," ")')
				item(mode='multiple' title='High quality (480 px, 15 fps)'
					tip='Best colors and smoothness, bigger file'
					cmd='powershell.exe' args='@ff_run -Preset gif -Value 3 @sel(true," ")')
			}
			item(mode='multiple' title='Vertical 9:16 (Shorts, TikTok, Reels)'
				tip='1080×1920: video centered on a blurred background'
				cmd='powershell.exe' args='@ff_run -Preset vertical @sel(true," ")')
			item(mode='multiple' title='Frame from the middle (JPG)'
				cmd='powershell.exe' args='@ff_run -Preset frame @sel(true," ")')
			item(mode='multiple' title='Thumbnail grid 4×4 (JPG)'
				tip='16 evenly spaced frames from the whole video on one picture'
				cmd='powershell.exe' args='@ff_run -Preset sheet @sel(true," ")')
			item(mode='multiple' title='Reverse'
				tip='For short clips: a long video takes a lot of memory'
				cmd='powershell.exe' args='@ff_run -Preset reverse @sel(true," ")')
			separator()
			item(mode='multiple' title='Frames every N seconds to a folder…'
				tip='Asks for the interval and saves JPGs to a separate folder'
				cmd='powershell.exe' args='@ff_run -Preset frames @sel(true," ")')
			item(mode='multiple' title='Teaser (6 clips of 2 s)'
				tip='A short clip of pieces from the whole video - to show what it is about'
				cmd='powershell.exe' args='@ff_run -Preset teaser @sel(true," ")')
		}
	}
	menu(mode='multiple' expanded=1 find=ff_audio)
	{
		menu(mode='multiple' title='Convert')
		{
			item(mode='multiple' find='!.mp3' title='To MP3 (320 kbps)'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value mp3 @sel(true," ")')
			item(mode='multiple' title='To MP3 (VBR, about 190 kbps)'
				tip='Almost the same quality, smaller file'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value mp3vbr @sel(true," ")')
			item(mode='multiple' find='!.m4a' title='To M4A (AAC 256 kbps)'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value m4a @sel(true," ")')
			item(mode='multiple' find='!.opus' title='To OPUS (160 kbps)'
				tip='The most modern codec: best quality per kilobyte'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value opus @sel(true," ")')
			item(mode='multiple' find='!.ogg' title='To OGG (Vorbis)'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value ogg @sel(true," ")')
			item(mode='multiple' find='!.flac' title='To FLAC (lossless)'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value flac @sel(true," ")')
			item(mode='multiple' find='!.wav' title='To WAV'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value wav @sel(true," ")')
			item(mode='multiple' find='!.aiff' title='To AIFF'
				cmd='powershell.exe' args='@ff_run -Preset audio -Value aiff @sel(true," ")')
		}
		menu(mode='multiple' title='Louder' tip='+6 dB - about twice the amplitude')
		{
			item(mode='multiple' title='+3 dB'
				cmd='powershell.exe' args='@ff_run -Preset louder -Value 3 @sel(true," ")')
			item(mode='multiple' title='+6 dB'
				cmd='powershell.exe' args='@ff_run -Preset louder -Value 6 @sel(true," ")')
			item(mode='multiple' title='+10 dB'
				cmd='powershell.exe' args='@ff_run -Preset louder -Value 10 @sel(true," ")')
		}
		menu(mode='multiple' title='Quieter')
		{
			item(mode='multiple' title='-3 dB'
				cmd='powershell.exe' args='@ff_run -Preset quieter -Value 3 @sel(true," ")')
			item(mode='multiple' title='-6 dB'
				cmd='powershell.exe' args='@ff_run -Preset quieter -Value 6 @sel(true," ")')
			item(mode='multiple' title='-10 dB'
				cmd='powershell.exe' args='@ff_run -Preset quieter -Value 10 @sel(true," ")')
		}
		item(mode='multiple' title='Normalize loudness'
			tip='Bring to standard loudness (EBU R128, -16 LUFS)'
			cmd='powershell.exe' args='@ff_run -Preset normalize @sel(true," ")')
		item(mode='multiple' title='Trim silence at start and end'
			tip='Cuts silence below -50 dB at both ends'
			cmd='powershell.exe' args='@ff_run -Preset silence @sel(true," ")')
		item(mode='multiple' title='Trim…'
			tip='Asks for start and end, without re-encoding'
			cmd='powershell.exe' args='@ff_run -Preset trim @sel(true," ")')
		menu(mode='multiple' title='Speed' tip='The pitch stays the same')
		{
			item(mode='multiple' title='0.5×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 0.5 @sel(true," ")')
			item(mode='multiple' title='0.75×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 0.75 @sel(true," ")')
			item(mode='multiple' title='1.25×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 1.25 @sel(true," ")')
			item(mode='multiple' title='1.5×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 1.5 @sel(true," ")')
			item(mode='multiple' title='2×'
				cmd='powershell.exe' args='@ff_run -Preset speed -Value 2 @sel(true," ")')
		}
		item(mode='multiple' where=sel.count>1 title='Join the selected into one file'
			tip='In alphabetical order, without re-encoding. The files must be of the same format'
			cmd='powershell.exe' args='@ff_run -Preset concat @sel(true," ")')
		item(mode='multiple' title='Split into parts…'
			tip='Asks how many minutes per part. Without re-encoding'
			cmd='powershell.exe' args='@ff_run -Preset split @sel(true," ")')
		item(mode='multiple' title='Clean up voice noise'
			tip='For voice recordings, podcasts and dictaphone files'
			cmd='powershell.exe' args='@ff_run -Preset voice @sel(true," ")')
		separator()
		item(mode='multiple' title='Make a video (cover or waveform)'
			tip='For YouTube and Telegram: the picture is the cover from the file, or a waveform if there is none'
			cmd='powershell.exe' args='@ff_run -Preset musicvideo @sel(true," ")')
		item(mode='multiple' title='Spectrogram (PNG)'
			tip='Shows the real quality: a FLAC “upscaled” from MP3 has everything above 16 kHz cut'
			cmd='powershell.exe' args='@ff_run -Preset spectrum @sel(true," ")')
		item(mode='multiple' title='Strip metadata'
			tip='Tags; the cover stays in the stream. Without re-encoding'
			cmd='powershell.exe' args='@ff_run -Preset stripmeta @sel(true," ")')
	}
	menu(mode='multiple' expanded=1 find=ff_image)
	{
		menu(mode='multiple' title='Convert')
		{
			item(mode='multiple' find='!.jpg' title='To JPG'
				cmd='powershell.exe' args='@ff_run -Preset image -Value jpg @sel(true," ")')
			item(mode='multiple' find='!.png' title='To PNG'
				tip='Lossless'
				cmd='powershell.exe' args='@ff_run -Preset image -Value png @sel(true," ")')
			item(mode='multiple' find='!.webp' title='To WebP (quality 90)'
				tip='Smaller than JPG at the same quality'
				cmd='powershell.exe' args='@ff_run -Preset image -Value webp @sel(true," ")')
			item(mode='multiple' find='!.avif' title='To AVIF'
				tip='The most compact format, opens in new browsers and Windows 11'
				cmd='powershell.exe' args='@ff_run -Preset image -Value avif @sel(true," ")')
			separator()
			item(mode='multiple' title='To an ICO icon (256×256)'
				tip='The image is fitted into a square with transparent margins'
				cmd='powershell.exe' args='@ff_run -Preset ico @sel(true," ")')
			item(mode='multiple' title='Compress for websites (WebP, up to 2560 px)'
				tip='For blogs, forums and websites: small file, good quality'
				cmd='powershell.exe' args='@ff_run -Preset web @sel(true," ")')
		}
		menu(mode='multiple' title='Upscale' tip='Simple upscaling (lanczos): a bigger picture, but no new details')
		{
			item(mode='multiple' title='×2'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 2 @sel(true," ")')
			item(mode='multiple' title='×3'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 3 @sel(true," ")')
			item(mode='multiple' title='×4'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 4 @sel(true," ")')
			item(mode='multiple' title='×5'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 5 @sel(true," ")')
			item(mode='multiple' title='×6'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 6 @sel(true," ")')
			item(mode='multiple' title='×7'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 7 @sel(true," ")')
			item(mode='multiple' title='×8'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 8 @sel(true," ")')
			item(mode='multiple' title='×9'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 9 @sel(true," ")')
			item(mode='multiple' title='×10'
				cmd='powershell.exe' args='@ff_run -Preset upscale -Value 10 @sel(true," ")')
		}
		menu(mode='multiple' title='Downscale')
		{
			item(mode='multiple' title='2 times smaller'
				cmd='powershell.exe' args='@ff_run -Preset downscale -Value 2 @sel(true," ")')
			item(mode='multiple' title='3 times smaller'
				cmd='powershell.exe' args='@ff_run -Preset downscale -Value 3 @sel(true," ")')
			item(mode='multiple' title='4 times smaller'
				cmd='powershell.exe' args='@ff_run -Preset downscale -Value 4 @sel(true," ")')
		}
		menu(mode='multiple' title='Rotate')
		{
			item(mode='multiple' title='90° clockwise'
				cmd='powershell.exe' args='@ff_run -Preset irotate -Value right @sel(true," ")')
			item(mode='multiple' title='90° counterclockwise'
				cmd='powershell.exe' args='@ff_run -Preset irotate -Value left @sel(true," ")')
			item(mode='multiple' title='180°'
				cmd='powershell.exe' args='@ff_run -Preset irotate -Value 180 @sel(true," ")')
			separator()
			item(mode='multiple' title='Flip horizontally'
				cmd='powershell.exe' args='@ff_run -Preset irotate -Value hflip @sel(true," ")')
			item(mode='multiple' title='Flip vertically'
				cmd='powershell.exe' args='@ff_run -Preset irotate -Value vflip @sel(true," ")')
		}
		item(mode='multiple' title='Black and white'
			cmd='powershell.exe' args='@ff_run -Preset gray @sel(true," ")')
		item(mode='multiple' where=sel.count>1 title='Slideshow from the selected (MP4)'
			tip='In alphabetical order, 1920×1080. Asks how many seconds to show each'
			cmd='powershell.exe' args='@ff_run -Preset slideshow @sel(true," ")')
	}
	separator()
	// Information
	menu(mode='multiple' where=sel.count==2 title='Video + music' tip='Select one video and one audio file')
	{
		item(mode='multiple' title='Replace the audio with music'
			tip='The video audio is replaced with the selected file; short music loops'
			cmd='powershell.exe' args='@ff_run -Preset addaudio -Value replace @sel(true," ")')
		item(mode='multiple' title='Add background music'
			tip='The music is quieter and plays over the original audio; short music loops'
			cmd='powershell.exe' args='@ff_run -Preset addaudio -Value mix @sel(true," ")')
	}
	menu(mode='multiple' expanded=1 find=ff_video+'|'+ff_audio)
	{
		item(mode='multiple' title='Check for errors'
			tip='Full decode: shows whether the file has broken parts'
			cmd='powershell.exe' args='@ff_run -Preset check @sel(true," ")')
	}
	item(mode='multiple' title='File info' tip='Codecs, resolution, duration, bitrate'
		cmd-line=`/c (for %f in (@(sel(true," "))) do (echo. & "@ff_probe" -hide_banner "%~f")) & echo. & pause`)
	item(mode='single' find=ff_video+'|'+ff_audio title='Play in ffplay' tip='Space = pause, Esc = close'
		cmd=ff_play args='-hide_banner "@sel.path"')
	item(mode='multiple' title='FFmpeg version' keys='Shift' vis=key.shift()
		cmd-line=`/c ("@ff_exe" -hide_banner -version) & pause`)
}
