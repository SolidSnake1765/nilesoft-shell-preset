// Theme “Modern”: an almost transparent menu with blur - the original theme of the preset author
$preset_theme = 'modern'

theme
{
    name = "modern"
    dark = auto

    background
    {
        color = #252525
        opacity = 5
        effect = 2 // 0 = off, 1 = transparent, 2 = blur, 3 = acrylic
    }

    border
    {
        enabled = true
        size = 1
        color = #3A3B3C
        opacity = 100
        radius = 2
    }

    image.align = 2

    layout
    {
        popup = 0
    }
}
